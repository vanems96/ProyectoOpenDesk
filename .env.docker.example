# Configuracion de demostracion para Docker Compose. Copiar a .env.
# No guardar credenciales reales en Git. Solo app expone un puerto en localhost.
OPENDESK_PROFILE=local
OPENDESK_PRIVATE_CONFIG=/opt/opendesk/config.php
MONGODB_URI=mongodb://mongo:27017/?directConnection=true
MONGODB_DATABASE=opendesk_demo
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=socket
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=grupo3:opendesk:docker:
APP_PASSWORD_HASH=
APP_PORT=8080
