# Plantilla sin secretos. La aplicación NO carga .env automáticamente.
# Exportar estas variables en el proceso PHP o adaptar config.example.php.
OPENDESK_PROFILE=local
OPENDESK_PRIVATE_CONFIG=/ruta/fuera/del/directorio/publico/config.php
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=opendesk
REDIS_HOST=127.0.0.1
REDIS_CLIENT=auto
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
APP_PASSWORD_HASH=

# Redis compartido: no cambiar grupo3: por un prefijo sin grupo.
REDIS_PREFIX=grupo3:opendesk:
REDIS_USERNAME=
# Solo para compatibilidad con configuración Atlas anterior.
ATLAS_CONFIG_SOURCE=/ruta/privada/configuracion-atlas.php
